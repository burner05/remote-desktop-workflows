name: WINDOWS RDP - 9ROUTER TUNNEL

on:
  workflow_dispatch

jobs:
  build:
    runs-on: windows-latest
    timeout-minutes: 360

    steps:
      - name: Install Node.js (Required for 9router)
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Enable Windows RDP
        run: |
          Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -name "fDenyTSConnections" -Value 0
          Enable-NetFirewallRule -DisplayGroup "Remote Desktop"
          Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp' -name "UserAuthentication" -Value 1
          Write-Host "✅ RDP Enabled"

      - name: Set Password
        run: |
          $securePassword = ConvertTo-SecureString -AsPlainText "P@ssw0rd123!" -Force
          Set-LocalUser -Name "runneradmin" -Password $securePassword
          Write-Host "✅ Password set to: P@ssw0rd123!"

      - name: Set Turkish Q Keyboard
        run: |
          Write-Host "Türkçe Q klavye ayarlanıyor..."
          $LangList = New-WinUserLanguageList tr-TR
          $LangList[0].InputMethodTips.Clear()
          $LangList[0].InputMethodTips.Add("041F:0000041F")
          Set-WinUserLanguageList -LanguageList $LangList -Force
          Set-WinSystemLocale -SystemLocale tr-TR
          Set-Culture -CultureInfo tr-TR
          Write-Host "✅ Türkçe Q klavye ayarlandı"

      - name: Install and Start 9router
        run: |
          Write-Host "9router indiriliyor ve kuruluyor..."
          npm install -g 9router
          
          Write-Host "9router başlatılıyor..."
          Start-Process -FilePath "cmd" -ArgumentList "/c", "9router" -WindowStyle Hidden
          
          Write-Host "9router'ın başlaması bekleniyor (30 saniye)..."
          Start-Sleep -Seconds 30
          
          Write-Host "✅ 9router kuruldu ve başlatıldı"

      - name: Enable Cloudflare Tunnel via 9router API
        run: |
          Write-Host "============================================"
          Write-Host "🚀 9ROUTER CLOUDFLARE TUNNEL OLUŞTURULUYOR"
          Write-Host "============================================"
          
          $tunnelEnabled = $false
          $tunnelUrl = ""
          $apiKey = ""
          
          Write-Host "Cloudflare Tunnel enable ediliyor..."
          try {
            $enableResponse = Invoke-RestMethod -Uri "http://localhost:20128/api/tunnel/cloudflare-enable" -Method POST -ContentType "application/json"
            Write-Host "Tunnel enable response: $($enableResponse | ConvertTo-Json)"
          } catch {
            Write-Host "Tunnel enable hatası: $_"
          }
          
          for ($i = 1; $i -le 50; $i++) {
            Start-Sleep -Seconds 3
            
            try {
              $statusResponse = Invoke-RestMethod -Uri "http://localhost:20128/api/tunnel/status" -Method GET
              
              if ($statusResponse.tunnel -and $statusResponse.tunnel.url) {
                $tunnelUrl = $statusResponse.tunnel.url
                Write-Host "✅ Tunnel URL bulundu: $tunnelUrl"
                $tunnelEnabled = $true
                break
              }
            } catch {
              Write-Host "Status check hatası: $_"
            }
            
            Write-Host "Tunnel URL bekleniyor... ($i/50)"
          }
          
          Write-Host "API Key alınıyor..."
          try {
            $configResponse = Invoke-RestMethod -Uri "http://localhost:20128/api/config" -Method GET
            if ($configResponse.apiKey) {
              $apiKey = $configResponse.apiKey
            }
          } catch {
            Write-Host "API Key alınamadı: $_"
          }
          
          if ($tunnelEnabled -and $tunnelUrl) {
            Write-Host ""
            Write-Host "============================================"
            Write-Host "✅ 9ROUTER TUNNEL HAZIR!"
            Write-Host "============================================"
            Write-Host "TUNNEL URL : $tunnelUrl"
            Write-Host "API KEY    : $apiKey"
            Write-Host "RDP USER   : runneradmin"
            Write-Host "RDP PASS   : P@ssw0rd123!"
            Write-Host "============================================"
            Write-Host ""
            Write-Host "9router Endpoint: $tunnelUrl/v1"
            Write-Host ""
          } else {
            Write-Host "❌ Tunnel URL alınamadı!"
            exit 1
          }
          
          while ($true) {
            Start-Sleep -Seconds 60
            Write-Host "✓ Aktif - $(Get-Date -Format 'HH:mm:ss')"
          }
